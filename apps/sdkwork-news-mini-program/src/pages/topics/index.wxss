.page {
  min-height: 100vh;
  background: #f4f5f2;
}

.top {
  padding: 34rpx 30rpx 26rpx;
  background:
    radial-gradient(circle at 84% 12%, #ffe6e2 0, transparent 45%),
    #fff;
  border-bottom: 1rpx solid #edf0ec;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
}

.subtitle {
  display: block;
  margin-top: 8rpx;
  color: #8a928c;
  font-size: 21rpx;
  line-height: 1.5;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  padding: 24rpx;
}

.topic-card {
  position: relative;
  height: 360rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #202521;
}

.topic-image {
  width: 100%;
  height: 100%;
  opacity: 0.7;
}

.topic-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(10, 15, 12, 0.05) 20%, rgba(9, 14, 11, 0.94) 100%);
}

.topic-copy {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  left: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.topic-top {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.topic-tag {
  padding: 3rpx 9rpx;
  border-radius: 4rpx;
  background: #e63b2e;
  color: #fff;
  font-size: 16rpx;
  font-weight: 700;
}

.topic-count {
  color: rgba(255, 255, 255, 0.7);
  font-size: 16rpx;
}

.topic-title {
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
  line-height: 1.35;
}

.topic-desc {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 19rpx;
  line-height: 1.5;
}

.note {
  margin: 4rpx 24rpx 0;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fff;
}

.note-title {
  display: block;
  color: #333b36;
  font-size: 24rpx;
  font-weight: 700;
}

.note-copy {
  display: block;
  margin-top: 8rpx;
  color: #8a928c;
  font-size: 20rpx;
  line-height: 1.6;
}
