<view class="page">
  <view style="height: {{statusBarHeight}}px"></view>

  <view class="top">
    <view class="title-row">
      <text class="title">今日热榜</text>
      <view class="badge">实时</view>
    </view>
    <text class="subtitle">全网热度聚合 · 每 5 分钟更新</text>
  </view>

  <view wx:if="{{loading}}" class="state">
    <view class="spinner"></view>
    <text>正在聚合热榜</text>
  </view>

  <view wx:elif="{{errorMessage}}" class="state">
    <text>{{errorMessage}}</text>
    <button class="retry" bindtap="retry">重新加载</button>
  </view>

  <view wx:else class="list">
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="row tap"
      data-id="{{item.id}}"
      bindtap="openArticle"
    >
      <text class="rank {{item.isHot ? 'is-hot' : ''}}">{{item.rank}}</text>
      <view class="row-copy">
        <text class="row-title ellipsis-2">{{item.title}}</text>
        <view class="row-meta">
          <text>{{item.source}}</text>
          <text>{{item.categoryLabel}}</text>
          <text>{{item.readLabel}}</text>
        </view>
      </view>
      <text class="row-arrow">›</text>
    </view>
  </view>
  <view class="safe-bottom"></view>
</view>
