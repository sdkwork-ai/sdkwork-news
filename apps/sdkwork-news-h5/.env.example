# Public runtime endpoints only. Credentials are provided by the IAM runtime.
VITE_SDKWORK_NEWS_PLATFORM_API_GATEWAY_HTTP_URL=
VITE_SDKWORK_NEWS_APPLICATION_PUBLIC_HTTP_URL=
VITE_SDKWORK_IAM_APPLICATION_PUBLIC_HTTP_URL=
VITE_SDKWORK_IAM_DEPLOYMENT_MODE=local
VITE_SDKWORK_NEWS_APP_ID=sdkwork-news
VITE_SDKWORK_NEWS_AGENTS_APP_API_BASE_URL=
VITE_SDKWORK_NEWS_IM_API_BASE_URL=
VITE_SDKWORK_NEWS_IM_WEBSOCKET_URL=
VITE_SDKWORK_APPSTORE_APPLICATION_PUBLIC_HTTP_URL=
VITE_SDKWORK_SKILLS_APPLICATION_PUBLIC_HTTP_URL=
VITE_SDKWORK_MCP_APPLICATION_PUBLIC_HTTP_URL=
VITE_SDKWORK_COMMENTS_APPLICATION_PUBLIC_HTTP_URL=
VITE_SDKWORK_NEWS_DEMO_MODE=false
VITE_SDKWORK_NEWS_ENVIRONMENT=development

# --- Deploy application identity anchor (required build and runtime input) ---
# The public application access token's `app_id`/`aud` are this installation's
# deploy application id, not a repository-owned runtime id: IAM suppresses a token
# carrying the retired runtime app id. Export the anchor on the build host before
# `pnpm workflow:materialize-client-env`, which rewrites every committed client env
# profile of the declared surfaces with it, and keep it set at runtime.
# The materializer fails, naming this variable, when it is unset or empty, so a
# build can never fall back to a compiled-in application id.
SDKWORK_DEPLOY_APPLICATION_ID=
