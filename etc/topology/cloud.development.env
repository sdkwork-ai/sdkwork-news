# cloud.development
SDKWORK_NEWS_DEPLOYMENT_PROFILE=cloud
SDKWORK_NEWS_ENVIRONMENT=development
SDKWORK_NEWS_PROFILE_ID=cloud.development
SDKWORK_NEWS_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
SDKWORK_NEWS_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_NEWS_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_NEWS_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_NEWS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_NEWS_WEB_DEV_INGRESS_BIND=127.0.0.1:5575
SDKWORK_NEWS_PC_INTERNAL_DEV_PORT=5577
SDKWORK_NEWS_H5_INTERNAL_DEV_PORT=5578


# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5575,http://localhost:5575,https://news-dev.sdkwork.com,http://news-dev.sdkwork.com,https://news-dev.birdcoder.com,http://news-dev.birdcoder.com,https://news-dev.dtupay.com,http://news-dev.dtupay.com,https://news-dev.noaper.com,http://news-dev.noaper.com,https://news-dev.sdkwork.cn,http://news-dev.sdkwork.cn,https://news-dev.birdcoder.cn,http://news-dev.birdcoder.cn,https://news-dev.dtupay.cn,http://news-dev.dtupay.cn,https://news-dev.noaper.cn,http://news-dev.noaper.cn,https://news-dev.skubc.com,http://news-dev.skubc.com,https://news-dev.skubc.cn,http://news-dev.skubc.cn,https://news-dev.zowalk.com,http://news-dev.zowalk.com,https://news-dev.zowalk.cn,http://news-dev.zowalk.cn,https://news-dev.offer86.com,http://news-dev.offer86.com,https://news-dev.offer86.cn,http://news-dev.offer86.cn,https://news-dev.86offer.com,http://news-dev.86offer.com,https://news-dev.86offer.cn,http://news-dev.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
