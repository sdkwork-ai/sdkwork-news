# Bootstrap profile cloud.staging — replace with application-specific values.
SDKWORK_NEWS_DEPLOYMENT_PROFILE=cloud
SDKWORK_NEWS_ENVIRONMENT=staging
SDKWORK_NEWS_PROFILE_ID=cloud.staging
SDKWORK_NEWS_APPLICATION_PUBLIC_HTTP_URL=https://news-staging.sdkwork.com
SDKWORK_NEWS_PLATFORM_API_GATEWAY_HTTP_URL=https://api-staging.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_NEWS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

