# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL schema `sdkwork_news_demo` and a dedicated
# Redis logical DB index (this repo's profiles declare no Redis key; the demo MUST use `-demo`
# prefix or a dedicated logical DB index) so that no cache key ever collides with another
# shared-redis environment.
SDKWORK_NEWS_DEPLOYMENT_PROFILE=standalone
SDKWORK_NEWS_ENVIRONMENT=demo
SDKWORK_NEWS_PROFILE_ID=standalone.demo
SDKWORK_NEWS_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:8081
SDKWORK_NEWS_APPLICATION_PUBLIC_HTTP_URL=http://news-demo.sdkwork.com:8081
VITE_SDKWORK_NEWS_APPLICATION_PUBLIC_HTTP_URL=http://news-demo.sdkwork.com:8081

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_NEWS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_NEWS_WEB_DEV_INGRESS_BIND=127.0.0.1:5575
SDKWORK_NEWS_PC_INTERNAL_DEV_PORT=5577
SDKWORK_NEWS_H5_INTERNAL_DEV_PORT=5578
