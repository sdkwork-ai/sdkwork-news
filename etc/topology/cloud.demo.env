# cloud.demo — cloud independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL schema `sdkwork_news_demo` and a dedicated
# Redis logical DB index (this repo's profiles declare no Redis key; the demo MUST use `-demo`
# prefix or a dedicated logical DB index) so no cache key collides with another shared-redis environment.
SDKWORK_NEWS_DEPLOYMENT_PROFILE=cloud
SDKWORK_NEWS_ENVIRONMENT=demo
SDKWORK_NEWS_PROFILE_ID=cloud.demo
SDKWORK_NEWS_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
SDKWORK_NEWS_APPLICATION_PUBLIC_HTTP_URL=https://news-demo.sdkwork.com
VITE_SDKWORK_NEWS_APPLICATION_PUBLIC_HTTP_URL=https://news-demo.sdkwork.com
VITE_SDKWORK_NEWS_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_NEWS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_NEWS_WEB_DEV_INGRESS_BIND=127.0.0.1:5575
SDKWORK_NEWS_PC_INTERNAL_DEV_PORT=5577
SDKWORK_NEWS_H5_INTERNAL_DEV_PORT=5578
SDKWORK_CORS_ALLOWED_ORIGINS=https://news-demo.sdkwork.com,http://news-demo.sdkwork.com,https://news-demo.birdcoder.com,http://news-demo.birdcoder.com,https://news-demo.dtupay.com,http://news-demo.dtupay.com,https://news-demo.noaper.com,http://news-demo.noaper.com,https://news-demo.sdkwork.cn,http://news-demo.sdkwork.cn,https://news-demo.birdcoder.cn,http://news-demo.birdcoder.cn,https://news-demo.dtupay.cn,http://news-demo.dtupay.cn,https://news-demo.noaper.cn,http://news-demo.noaper.cn,https://news-demo.skubc.com,http://news-demo.skubc.com,https://news-demo.skubc.cn,http://news-demo.skubc.cn,https://news-demo.zowalk.com,http://news-demo.zowalk.com,https://news-demo.zowalk.cn,http://news-demo.zowalk.cn,https://news-demo.offer86.com,http://news-demo.offer86.com,https://news-demo.offer86.cn,http://news-demo.offer86.cn,https://news-demo.86offer.com,http://news-demo.86offer.com,https://news-demo.86offer.cn,http://news-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
